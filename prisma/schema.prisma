generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ItemKind {
  TOP
  BOTTOM
  SHOE
}

enum ColorFamily {
  BLACK
  WHITE
  BLUE
  BROWN
  GREEN
  RED
  PINK
  GREY
  BEIGE
  YELLOW
  MULTI
  UNKNOWN
}

enum Pattern {
  SOLID
  STRIPED
  CHECKERED
  GRAPHIC
  PRINTED
  TEXTURED
  UNKNOWN
}

enum StyleProfile {
  CASUAL
  SMART_CASUAL
  ATHLEISURE
  FORMAL
  UNKNOWN
}

enum Formality {
  RELAXED
  ELEVATED
  DRESSY
  UNKNOWN
}

enum WarmthLevel {
  LIGHT
  MID
  WARM
  UNKNOWN
}

enum AnalysisStatus {
  PENDING
  READY
  FAILED
  SKIPPED
}

enum MetadataSource {
  MANUAL
  AI
  MIXED
}

enum DnaAssetStatus {
  PENDING
  GENERATING
  READY
  FAILED
}

enum TryOnJobStatus {
  PENDING
  RUNNING
  READY
  FAILED
}

model User {
  id                   String          @id @db.Uuid
  email                String?         @unique
  name                 String?
  avatarUrl            String?
  displayName          String?
  uploadedAvatarUrl    String?
  aiTryOnPhotoUrl      String?
  aiTryOnPhotoMimeType String?
  stylePreferences     Json?
  lastDnaRegenAt       DateTime?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  items                Item[]
  history              OutfitHistory[]
  styleDna             StyleDNA?
  tryOnJobs            TryOnJob[]
}

/// Async try-on generation jobs. Generation takes 45–120s, far beyond the
/// Netlify synchronous function timeout, so POST /api/tryon creates a job,
/// a background worker processes it, and the client polls for the result.
model TryOnJob {
  id             String         @id @default(cuid())
  userId         String         @db.Uuid
  topItemId      String
  bottomItemId   String
  shoeItemId     String
  provider       String
  status         TryOnJobStatus @default(PENDING)
  errorCode      String?
  /// Supabase Storage object path of the generated image; signed on read.
  resultPath     String?
  resultMimeType String?
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model StyleDNA {
  id                   String         @id @default(cuid())
  userId               String         @db.Uuid @unique
  version              Int            @default(1)
  archetypeName        String
  description          String
  traits               String[]
  colorPalette         String[]
  imagePromptHints     String[]
  promptHash           String?
  moodboardUrl         String?
  moodboardStatus      DnaAssetStatus @default(PENDING)
  textStatus           DnaAssetStatus @default(PENDING)
  generationTrigger    String?
  promptSnapshot       Json?
  generatedAt          DateTime?
  moodboardGeneratedAt DateTime?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  user                 User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([promptHash])
}

model Item {
  id           String       @id @default(cuid())
  userId       String       @db.Uuid
  createdAt    DateTime     @default(now())
  kind         ItemKind
  subtype      String
  colorFamily  ColorFamily  @default(UNKNOWN)
  pattern      Pattern      @default(UNKNOWN)
  styleProfile StyleProfile @default(UNKNOWN)
  formality    Formality    @default(UNKNOWN)
  warmthLevel  WarmthLevel  @default(UNKNOWN)
  analysisStatus AnalysisStatus @default(SKIPPED)
  metadataSource MetadataSource @default(MANUAL)
  visualSummary String?
  analysisConfidence Float?
  analysisModel String?
  analysisPromptVersion String?
  analysisErrorCode String?
  /// Canonical Supabase Storage object path. API responses replace this with a signed URL.
  photoUrl     String
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, kind])
}

model OutfitHistory {
  id           String   @id @default(cuid())
  userId       String   @db.Uuid
  date         DateTime
  createdAt    DateTime @default(now())
  topItemId    String
  bottomItemId String
  shoeItemId   String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}

model AppConfig {
  key            String   @id
  value          String
  description    String?
  possibleValues String?
  updatedAt      DateTime @updatedAt
}

/// Fixed-window rate limit counters. Backed by Postgres so limits hold across
/// serverless instances and cold starts; rows are pruned opportunistically.
model RateLimit {
  key         String   @id
  count       Int
  windowStart DateTime
}
